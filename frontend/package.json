{
  "name": "fallow-clock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "json-schema-to-typescript src/types/bundle.schema.json -o src/types/bundle.ts --no-additionalProperties",
    "refresh:contract": "cd ../backend && python scripts/export_schema.py && cd ../frontend && npm run gen:types",
    "sync:sprites": "node scripts/sync-sprites.mjs"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "d3-shape": "^3.2.0",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "json-schema-to-typescript": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
